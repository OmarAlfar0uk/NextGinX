    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "mail:outbox": "node scripts/process-outbox.mjs",
    "test:integration": "node --test tests/integration/postgres.test.mjs",
