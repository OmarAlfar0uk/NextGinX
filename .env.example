# Public production URL. Leave empty in local development; canonical URLs and sitemap use this value.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection string (required for CMS/admin/lead persistence).
DATABASE_URL=postgresql://nextginx_dev:local_only_change_me@localhost:5432/nextginx_dev?schema=public

# docker-compose.yml development-only defaults (change for your own machine).
POSTGRES_DB=nextginx_dev
POSTGRES_USER=nextginx_dev
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=5432

# Contact details are intentionally blank until supplied by NextGinX.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional Resend delivery. The API key must remain server-side.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# S3-compatible media storage (required for admin uploads).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
