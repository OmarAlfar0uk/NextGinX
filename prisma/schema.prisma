generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES_MANAGER
  SALES_AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  PAGE
  HOME
  SERVICE
  PROJECT
  INDUSTRY
  PROCESS
  TESTIMONIAL
  ARTICLE
  MENU
}

enum ProjectType {
  VERIFIED_CLIENT
  CONCEPT
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model AdminUser {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  passwordHash  String
  role          AdminRole            @default(EDITOR)
  active        Boolean              @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      AdminSession[]
  assignedLeads Lead[]               @relation("LeadAssignee")
  leadEvents    LeadEvent[]          @relation("LeadEventActor")
  notes         LeadNote[]
  auditEvents   AuditEvent[]
  content       ContentEntry[]
  permissions   UserPermission[]
  media         MediaAsset[]
  resetTokens   PasswordResetToken[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt, expiresAt])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(300)
  users       UserPermission[]
  roles       RolePermission[]
}

model RolePermission {
  role         AdminRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  user         AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model ContentEntry {
  id           String        @id @default(cuid())
  type         ContentType
  locale       String        @db.VarChar(2)
  slug         String        @db.VarChar(180)
  title        String        @db.VarChar(240)
  summary      String?       @db.VarChar(1000)
  content      Json
  seo          Json?
  status       PublishStatus @default(DRAFT)
  projectType  ProjectType?
  category     String?
  displayOrder Int           @default(0)
  publishedAt  DateTime?
  authorId     String?
  author       AdminUser?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([type, locale, slug])
  @@index([type, status, locale, displayOrder])
  @@index([publishedAt])
}

model SiteSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt
}

model Lead {
  id               String        @id @default(cuid())
  name             String        @db.VarChar(120)
  company          String?       @db.VarChar(160)
  email            String        @db.VarChar(254)
  phone            String?       @db.VarChar(40)
  country          String?       @db.VarChar(80)
  service          String        @db.VarChar(100)
  budget           String?       @db.VarChar(100)
  description      String        @db.VarChar(3000)
  preferredContact String?       @db.VarChar(50)
  sourcePage       String?       @db.VarChar(300)
  status           LeadStatus    @default(NEW)
  assigneeId       String?
  assignee         AdminUser?    @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  emailDelivered   Boolean       @default(false)
  emailError       String?       @db.VarChar(500)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  notes            LeadNote[]
  events           LeadEvent[]
  emailOutboxes    EmailOutbox[]

  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([email])
}

model LeadNote {
  id        String    @id @default(cuid())
  leadId    String
  authorId  String
  body      String    @db.VarChar(5000)
  createdAt DateTime  @default(now())
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
}

model LeadEvent {
  id        String     @id @default(cuid())
  leadId    String
  actorId   String?
  action    String     @db.VarChar(80)
  metadata  Json?
  createdAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     AdminUser? @relation("LeadEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model MediaAsset {
  id          String     @id @default(cuid())
  key         String     @unique
  publicUrl   String
  filename    String     @db.VarChar(255)
  contentType String     @db.VarChar(100)
  byteSize    Int
  width       Int?
  height      Int?
  altTextEn   String?    @db.VarChar(500)
  altTextAr   String?    @db.VarChar(500)
  ownerId     String?
  owner       AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([contentType, createdAt])
  @@index([ownerId, createdAt])
}

model EmailOutbox {
  id            String       @id @default(cuid())
  leadId        String
  recipient     String       @db.VarChar(254)
  subject       String       @db.VarChar(300)
  body          String       @db.Text
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lockedAt      DateTime?
  lastError     String?      @db.VarChar(500)
  nextAttemptAt DateTime     @default(now())
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([leadId, createdAt])
}

model AuditEvent {
  id        String     @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String     @db.VarChar(100)
  target    String?    @db.VarChar(200)
  metadata  Json?
  ipHash    String?    @db.VarChar(64)
  createdAt DateTime   @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
